{
  "name": "unihomelabdash",
  "version": "0.10.0",
  "description": "Self-hosted homelab PWA for manual services and on-demand health checks",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/uniskela/UniHomelabDash",
  "repository": {
    "type": "git",
    "url": "https://github.com/uniskela/UniHomelabDash.git"
  },
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0 -p 3004",
    "build": "next build",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0 -p 3004",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "reset-admin": "node scripts/reset-admin.mjs",
    "test": "node --import tsx --test src/lib/auth/*.test.ts src/lib/request/*.test.ts src/lib/providers/*.test.ts src/lib/providers/**/*.test.ts src/lib/activity/*.test.ts",
    "test:stack-detail-sheet": "node scripts/test-stack-detail-sheet-lifecycle.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "icons:export": "node scripts/export-icons.mjs",
    "site:dev": "npm --prefix site run dev",
    "site:test": "npm --prefix site test",
    "site:check": "npm --prefix site run check",
    "site:build": "npm --prefix site run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "playwright": "^1.62.1",
    "shadcn": "^4.16.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "overrides": {
    "esbuild": "^0.25.12"
  }
}
